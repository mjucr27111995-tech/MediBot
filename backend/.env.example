# MediBot Backend Configuration
# Copy this file to .env and fill in your values

# --- LLM Provider ---
# Google Gemini (default)
GOOGLE_API_KEY=your-google-api-key-here
LLM_MODEL=gemini-3.5-flash

# --- Embedding Model ---
# sentence-transformers model for dense embeddings (384 dimensions)
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBED_DIMENSION=384

# --- Sparse Embedding Model ---
SPARSE_EMBED_MODEL=Qdrant/bm25

# --- Qdrant ---
# Leave QDRANT_URL empty to use local file mode (no Docker needed)
# Set to http://localhost:6333 if running Qdrant in Docker
QDRANT_URL=
QDRANT_PATH=./qdrant_data
QDRANT_COLLECTION_NAME=medibot_docs

# --- Paths ---
DATA_DIR=../../mediassist_data
SQLITE_DB_PATH=../../mediassist_data/db/mediassist.db

# --- JWT ---
JWT_SECRET_KEY=change-this-to-a-random-secret-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- Retrieval ---
RETRIEVAL_TOP_K=10
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_TOP_N=3

# --- Chunking ---
MAX_CHUNK_TOKENS=512
